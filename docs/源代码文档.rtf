     \par     for (const word of words) \{\par       allPhraseWords.add(word);\par     \}\par   \}\par \par   // \u33719?\u21462?\u35789?\u27719?\u34920?\u20013?\u30340?\u25152?\u26377?\u21333?\u35789?\par   const vocabularyWords = new Set<string>();\par   \par   for (const wordItem of vocabularyData) \{\par     // \u28155?\u21152?\u33521?\u25991?\u21333?\u35789?\par     if (Array.isArray(wordItem.english)) \{\par       wordItem.english.forEach(eng => \{\par         vocabularyWords.add(eng.toLowerCase());\par       \});\par     \} else if (typeof wordItem.english === 'string') \{\par       vocabularyWords.add(wordItem.english.toLowerCase());\par     \}\par     \par     // \u21516?\u26102?\u32771?\u34385?chinese\u23383?\u27573?\u21487?\u33021?\u21253?\u21547?\u30340?\u33521?\u25991?\u21333?\u35789?\par     if (Array.isArray(wordItem.chinese)) \{\par       for (const chinese of wordItem.chinese) \{\par         const chineseWords = chinese\par           .toLowerCase()\par           .replace(/[^\\w\\s]/g, ' ')\par           .split(/\\s+/)\par           .filter(word => word.trim().length > 0);\par           \par         chineseWords.forEach(w => vocabularyWords.add(w));\par       \}\par     \} else if (typeof wordItem.chinese === 'string') \{\par       const chineseWords = wordItem.chinese\par         .toLowerCase()\par         .replace(/[^\\w\\s]/g, ' ')\par         .split(/\\s+/)\par         .filter(word => word.trim().length > 0);\par \page         \par       chineseWords.forEach(w => vocabularyWords.add(w));\par     \}\par   \}\par \par   // \u25214?\u20986?\u19981?\u22312?\u35789?\u27719?\u34920?\u20013?\u30340?\u21333?\u35789?\par   const missingWords: string[] = [];\par   \par   for (const word of allPhraseWords) \{\par     if (!vocabularyWords.has(word)) \{\par       missingWords.push(word);\par     \}\par   \}\par \par   // \u25171?\u21360?\u32467?\u26524?\u21040?\u25511?\u21046?\u21488?\par   console.log("Phrases\u20013?\u32570?\u22833?\u30340?\u21333?\u35789?\