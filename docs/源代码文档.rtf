par   \}\par \par   return args;\par \}\par \par function readQuotedValue(expression) \{\par   const value = expression.trim();\par   if (!value) \{\par     return null;\par   \}\par \par   const quote = value[0];\par   if (!['\\'', '"', '`'].includes(quote)) \{\par     return null;\par   \}\par \par   let result = '';\par   let escaped = false;\par \par   for (let i = 1; i < value.length; i += 1) \{\par     const char = value[i];\par \par     if (escaped) \{\par       result += char;\par       escaped = false;\par       continue;\par     \}\par \par     if (char === '\\\\') \{\par       escaped = true;\par \page       continue;\par     \}\par \par     if (char === quote) \{\par       return result;\par     \}\par \par     result += char;\par   \}\par \par   return null;\par \}\par \par function extractCreateWordArgs(line) \{\par   const start = line.indexOf('createWord(');\par   if (start === -1) \{\par     return null;\par   \}\par \par   let quote = null;\par   let escaped = false;\par   let depth = 0;\par   let content = '';\par \par   for (let i = start + 'createWord('.length; i < line.length; i += 1) \{\par     const char = line[i];\par \par     if (escaped) \{\par       content += char;\par       escaped = false;\par       continue;\par     \}\par \par     if (quote) \{\par       content += char;\par       if (char === '\\\\') \{\par         escaped = true;\par       \} else if (char === quote) \{\par         quote = null;\par       \}\par       continue;\par     \}\par \par     if (char === '\\'' || char === '"' || char === '`') \{\par       quote = char;\par       content += char;\par       continue;\par     \}\par \par     if (char === '(' || char === '[' || char === '\{') \{\par \page       depth += 1;\par       content += char;\par       continue;\par     \}\par \par     if (char === ')' && depth === 0) \{\par       return splitTopLevelArgs(content);\par     \}\par \par     if (char === ')' || char === ']' || char === '\}') \{\par       depth -= 1;\par       content += char;\par       continue;\par     \}\par \par     content += char;\par   \}\par \par   return null;\par \}\par \par async function main() \{\par   const original = await fs.readFile(sourcePath, 'utf8');\par   const lines = original.split(/\\r?\\n/);\par   const seenWords = new Map();\par   const removedEntries = [];\par   const keptLines = [];\par \par   for (const line of lines) \{\par     const createWordArgs = extractCreateWordArgs(line);\par \par     if (!createWordArgs) \{\par       keptLines.push(line);\par       continue;\par     \}\par \par     const [, englishArg, chineseArg] = createWordArgs;\par     const english = readQuotedValue(englishArg);\par \par     if (!english) \{\par       keptLines.push(line);\par       continue;\par     \}\par \par     const key = english.trim().toLowerCase();\par \par     if (!seenWords.has(key)) \{\par       seenWords.set(key, \{\par         english,\par         chinese: readQuotedValue(chineseArg) ?? chineseArg,\par \page       \});\par       keptLines.push(line);\par       continue;\par     \}\par \par     removedEntries.push(\{\par       english,\par       line,\par       firstSeen: seenWords.get(key),\par     \});\par   \}\par \par   await fs.writeFile(outputPath, `$\{keptLines.join('\\n')\}\\n`, 'utf8');\par \par   console.log(`Source: $\{sourcePath\}`);\par   console.log(`Output: $\{outputPath\}`);\par   console.log(`Kept unique words: $\{seenWords.size\}`);\par   console.log(`Removed duplicates: $\{removedEntries.length\}`);\par \par   if (removedEntries.length > 0) \{\par     console.log('\\nRemoved entries:');\par     for (const entry of removedEntries) \{\par       console.log(`- $\{entry.english\} (first kept: $\{entry.firstSeen.chinese\par     \}\par   \}\par \par   if (!shouldWriteInPlace) \{\par     console.log('\\nTip: run with --write to overwrite data/vocabulary.ts dir\par   \}\par \}\par \par main().catch((error) => \{\par   console.error(error);\par   process.exitCode = 1;\par \});\par // ===================== \u25991?\u20214?: scripts/generate-vocabulary-tiers.mjs =========\par import fs from 'node:fs/promises';\par import path from 'node:path';\par import \{ fileURLToPath \} from 'node:url';\par \par const __filename = fileURLToPath(import.meta.url);\par const __dirname = path.dirname(__filename);\par const projectRoot = path.resolve(__dirname, '..');\par \par const sourcePath = path.join(projectRoot, 'data', 'vocabulary.ts');\par const outputPath = path.join(projectRoot, 'data', 'vocabularyTiers.ts');\par \par const CATEGORY_BONUS = \{\par   DailyLife: 3,\par   Basics: 4,\par \page   People: 3,\par   Home: 2,\par   DailyCommunication: 4,\par   TravelCommunication: 3,\par   WorkCommunication: 2,\par \};\par \par const CORE_SINGLE_WORDS = new Set([\par   'i', 'you', 'he', 'she', 'it', 'we', 'they',\par   'me', 'him', 'her', 'us', 'them',\par   'my', 'your', 'his', 'our', 'their',\par   'this', 'that', 'these', 'those',\par   'who', 'what', 'where', 'when', 'why', 'how', 'which',\par   'can', 'do', 'say', 'go', 'come', 'get', 'make', 'take', 'see', 'know',\par   'think', 'want', 'need', 'give', 'find', 'tell', 'ask', 'feel', 'try', 'us\par   'work', 'like', 'love', 'call', 'put', 'help', 'play', 'run', 'eat', 'drin\par   'sleep', 'read', 'write', 'speak', 'listen', 'watch', 'wait', 'buy', 'pay'\par   'sell', 'open', 'close', 'start', 'stop', 'live', 'walk', 'talk', 'learn',\par   'study', 'teach', 'answer', 'remember', 'forget', 'bring', 'keep', 'leave'\par   'move', 'show', 'meet', 'sit', 'stand', 'turn', 'begin', 'follow',\par   'good', 'bad', 'big', 'small', 'long', 'short', 'new', 'old', 'hot', 'cold\par   'happy', 'sad', 'easy', 'hard', 'fast', 'slow', 'right', 'wrong',\par   'today', 'tomorrow', 'yesterday', 'always', 'never', 'often', 'sometimes',\par   'now', 'soon', 'really', 'very', 'maybe', 'please', 'thanks', 'hello', 'by\par   'yes', 'no', 'ok', 'okay', 'time', 'day', 'week', 'month', 'year',\par   'man', 'woman', 'boy', 'girl', 'child', 'friend', 'family',\par   'water', 'food', 'money', 'phone', 'home', 'school', 'job', 'car', 'bus',\par ]);\par \par const CORE_PHRASES = [\par   'how are you',\par   'how are you doing',\par   'what do you think',\par   'how have you been',\par   "what's up",\par   "how's it going",\par   'long time no see',\par   'take care',\par   'never mind',\par   'of course',\par   'no problem',\par   'let me think',\par   "i don't know",\par   'i have no idea',\par   'that makes sense',\par   "i'm looking forward to",\par   "i need to",\par   'good to see you',\par   'excuse me',\par   'thank you',\par \page   'see you',\par ];\par \par const EXTENDED_SUFFIXES = [\par   'tion', 'sion', 'ment', 'ness', 'tude', 'ship', 'ology', 'ality',\par   'ential', 'ability', 'ibility', 'ization', 'isation', 'preneur',\par ];\par \par function splitTopLevelArgs(text) \{\par   const args = [];\par   let current = '';\par   let depth = 0;\par   let quote = null;\par   let escaped = false;\par \par   for (const char of text) \{\par     current += char;\par \par     if (escaped) \{\par       escaped = false;\par       continue;\par     \}\par \par     if (quote) \{\par       if (char === '\\\\') \{\par         escaped = true;\par       \} else if (char === quote) \{\par         quote = null;\par       \}\par       continue;\par     \}\par \par     if (char === '\\'' || char === '"' || char === '`') \{\par       quote = char;\par       continue;\par     \}\par \par     if (char === '(' || char === '[' || char === '\{') \{\par       depth += 1;\par       continue;\par     \}\par \par     if (char === ')' || char === ']' || char === '\}') \{\par       depth -= 1;\par       continue;\par     \}\par \par     if (char === ',' && depth === 0) \{\par       args.push(current.slice(0, -1).trim());\par       current = '';\par \page     \}\par   \}\par \par   if (current.trim()) \{\par     args.push(current.trim());\par   \}\par \par   return args;\par \}\par \par function readQuotedValue(expression) \{\par   const value = expression.trim();\par   if (!value) return null;\par \par   const quote = value[0];\par   if (!['\\'', '"', '`'].includes(quote)) return null;\par \par   let result = '';\par   let escaped = false;\par \par   for (let i = 1; i < value.length; i += 1) \{\par     const char = value[i];\par \par     if (escaped) \{\par       result += char;\par       escaped = false;\par       continue;\par     \}\par \par     if (char === '\\\\') \{\par       escaped = true;\par       continue;\par     \}\par \par     if (char === quote) \{\par       return result;\par     \}\par \par     result += char;\par   \}\par \par   return null;\par \}\par \par function extractCreateWordArgs(line) \{\par   const start = line.indexOf('createWord(');\par   if (start === -1) return null;\par \par   let quote = null;\par   let escaped = false;\par \page   let depth = 0;\par   let content = '';\par \par   for (let i = start + 'createWord('.length; i < line.length; i += 1) \{\par     const char = line[i];\par \par     if (escaped) \{\par       content += char;\par       escaped = false;\par       continue;\par     \}\par \par     if (quote) \{\par       content += char;\par       if (char === '\\\\') escaped = true;\par       else if (char === quote) quote = null;\par       continue;\par     \}\par \par     if (char === '\\'' || char === '"' || char === '`') \{\par       quote = char;\par       content += char;\par       continue;\par     \}\par \par     if (char === '(' || char === '[' || char === '\{') \{\par       depth += 1;\par       content += char;\par       continue;\par     \}\par \par     if (char === ')' && depth === 0) \{\par       return splitTopLevelArgs(content);\par     \}\par \par     if (char === ')' || char === ']' || char === '\}') \{\par       depth -= 1;\par       content += char;\par       continue;\par     \}\par \par     content += char;\par   \}\par \par   return null;\par \}\par \par function classifyEntry(\{ english, category \}) \{\par   const normalized = english.trim().toLowerCase();\par   const words = normalized.split(/\\s+/).filter(Boolean);\par \page   const wordCount = words.length;\par   const charLength = normalized.replace(/\\s+/g, '').length;\par   const isPhrase = wordCount > 1;\par   const hasPunctuation = /[!?.,]/.test(english);\par   const hasApostrophe = normalized.includes("'");\par   const categoryBonus = CATEGORY_BONUS[category] ?? 0;\par \par   let score = categoryBonus;\par \par   if (CORE_SINGLE_WORDS.has(normalized)) score += 5;\par   if (CORE_PHRASES.some((phrase) => normalized.includes(phrase))) score += 5\par \par   if (isPhrase) \{\par     score += 2;\par     if (wordCount <= 4) score += 2;\par     if (wordCount >= 7) score -= 1;\par   \} else \{\par     if (charLength <= 4) score += 3;\par     else if (charLength <= 7) score += 1;\par     else if (charLength >= 11) score -= 2;\par   \}\par \par   if (hasPunctuation) score += 1;\par   if (hasApostrophe) score += 1;\par \par   if (EXTENDED_SUFFIXES.some((suffix) => normalized.endsWith(suffix))) \{\par     score -= 2;\par   \}\par \par   if (/^[A-Z][a-z]+(?:\\s[A-Z][a-z]+)*$/.test(english) && !isPhrase) \{\par     score -= 1;\par   \}\par \par   if (wordCount >= 5 && category === 'WorkCommunication') \{\par     score -= 1;\par   \}\par \par   if (score >= 8) return 'core';\par   if (score >= 5) return 'active';\par   if (score >= 2) return 'extended';\par   return 'reserve';\par \}\par \par async function main() \{\par   const source = await fs.readFile(sourcePath, 'utf8');\par   const lines = source.split(/\\r?\\n/);\par   const entryMap = new Map();\par \par   for (const line of lines) \{\par     const args = extractCreateWordArgs(line);\par \page     if (!args) continue;\par \par     const [idArg, englishArg, , , categoryArg] = args;\par     const id = readQuotedValue(idArg);\par     const english = readQuotedValue(englishArg);\par     const category = categoryArg?.split('.').pop()?.replace(/[^A-Za-z]/g, ''\par \par     if (!id || !english || !category) continue;\par \par     const tier = classifyEntry(\{ english, category \});\par     entryMap.set(id, \{ id, english, category, tier \});\par   \}\par \par   const entries = Array.from(entryMap.values());\par \par   const counts = entries.reduce(\par     (acc, entry) => \{\par       acc[entry.tier] += 1;\par       return acc;\par     \},\par     \{ core: 0, active: 0, extended: 0, reserve: 0 \},\par   );\par \par   const linesOut = [\par     "export type VocabularyTier = 'core' | 'active' | 'extended' | 'reserve'\par     '',\par     'export const vocabularyTiers: Record<string, VocabularyTier> = \{',\par     ...entries.map((entry) => `  $\{JSON.stringify(entry.id)\}: $\{JSON.stringi\par     '\};',\par     '',\par   ];\par \par   await fs.writeFile(outputPath, `$\{linesOut.join('\\n')\}`, 'utf8');\par \par   console.log(`Generated $\{outputPath\}`);\par   console.log(counts);\par \par   for (const tier of ['core', 'active', 'extended', 'reserve']) \{\par     const sample = entries\par       .filter((entry) => entry.tier === tier)\par       .slice(0, 8)\par       .map((entry) => entry.english);\par     console.log(`$\{tier\}: $\{sample.join(' | ')\}`);\par   \}\par \}\par \par main().catch((error) => \{\par   console.error(error);\par   process.exitCode = 1;\par \});\par }