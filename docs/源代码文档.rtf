{\rtf1\ansi\deff0{\fonttbl{\f0 Courier New;}}\paperw11906\paperh16838\margl1134\margr1134\margt1134\margb1134\deflang2052\f0\fs18\sl276\slmult0 {\header\pard\qc\b\fs16\ul LinguaLeap \u33521?\u35821?\u33258?\u23398?\u21161?\u25163?\u36719?\u20214? V1.0 \u28304?\u20195?\u30721?\ulnone\b0\fs18\par}{\footer\pard\qc\fs16 \u31532? {\field{\*\fldinst{PAGE}}} \u39029? \par}// ===================== \u25991?\u20214?: index.tsx =====================\par import React from "react";\par import ReactDOM from "react-dom/client";\par import App from "./App";\par \par // \u24341?\u20837?\u21333?\u35789?\u26816?\u26597?\u22120?\par import \{\par   checkMissingWords,\par   checkMissingSentences,\par \} from "./services/wordChecker";\par \par // \u28210?\u26579?\u24212?\u29992?\u31243?\u24207?\par ReactDOM.createRoot(document.getElementById("root")!).render(\par   <React.StrictMode>\par     <App />\par   </React.StrictMode>,\par );\par \par // \u25191?\u34892?\u21333?\u35789?\u26816?\u26597?\par // checkMissingWords();\par // checkMissingSentences();\par // ===================== \u25991?\u20214?: App.tsx =====================\par import React, \{ useState, useEffect \} from 'react';\par import \{ Book, MessageSquare, Gamepad2, Settings as SettingsIcon, Graduation\par import \{ Button \} from 'antd'; // \u23548?\u20837? Ant Design \u30340? Button \u32452?\u20214?\par import \{ ViewState, TTSConfig, AppSettings \} from './types';\par import \{ VocabularyView \} from './components/VocabularyView';\par import \{ PhrasesView \} from './components/PhrasesView';\par import \{ GameView \} from './components/GameView';\par import \{ StudySession \} from './components/StudySession';\par import \{ StatisticsPanel \} from './components/StatisticsPanel';\par import \{ SettingsPanel \} from './components/SettingsPanel';\par import \{ PomodoroTimer \} from './components/PomodoroTimer';\par import \{ ListenView \} from './components/ListenView';\par import \{ storageService \} from './services/storage';\par \par const App: React.FC = () => \{\par   const [currentView, setCurrentView] = useState<ViewState>('vocabulary');\par   const [showSettings, setShowSettings] = useState(false);\par   const [isMobileMode, setIsMobileMode] = useState(window.innerWidth < 768);\par   \par   // Initialize TTS Config from storage\par   const [ttsConfig, setTtsConfig] = useState<TTSConfig>(() => storageService\par \par   // Initialize App Settings from storage\par   const [appSettings, setAppSettings] = useState<AppSettings>(() => storageS\par   \par   // \u28145?\u33394?\u27169?\u24335?\u29366?\u24577? ('auto' | 'light' | 'dark')\par   const [themeMode, setThemeMode] = useState<'auto' | 'light' | 'dark'>(() =\par     const savedSettings = storageService.getSettings();\par \page     return savedSettings.themeMode || 'auto';\par   \});\par \par   // \u23454?\u38469?\u24212?\u29992?\u30340?\u20027?\u39064?\par   const [actualTheme, setActualTheme] = useState<'light' | 'dark'>('light');\par \par   // Handle settings persistence and side effects\par   useEffect(() => \{\par     storageService.saveSettings(\{...appSettings, themeMode\});\par   \}, [appSettings, themeMode]);\par \par   // Handle TTS Config persistence\par   useEffect(() => \{\par     storageService.saveTTSConfig(ttsConfig);\par   \}, [ttsConfig]);\par \par   // \u22788?\u29702?\u20027?\u39064?\u21464?\u21270?\par   useEffect(() => \{\par     const updateTheme = () => \{\par       if (themeMode === 'auto') \{\par         const systemPrefersDark = window.matchMedia('(prefers-color-scheme: \par         setActualTheme(systemPrefersDark ? 'dark' : 'light');\par       \} else \{\par         setActualTheme(themeMode);\par       \}\par     \};\par \par     updateTheme();\par \par     // \u30417?\u21548?\u31995?\u32479?\u20027?\u39064?\u21464?\u21270?\par     const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');\par     const listener = (e: MediaQueryListEvent) => \{\par       if (themeMode === 'auto') \{\par         setActualTheme(e.matches ? 'dark' : 'light');\par       \}\par     \};\par \par     mediaQuery.addEventListener('change', listener);\par     return () => mediaQuery.removeEventListener('change', listener);\par   \}, [themeMode]);\par \par   // Handle Resize\par   useEffect(() => \{\par     const handleResize = () => \{\par        // Only auto-switch if user hasn't manually toggled (logic simplified\par     \};\par     window.addEventListener('resize', handleResize);\par     return () => window.removeEventListener('resize', handleResize);\par   \}, []);\par \par \page   const renderView = () => \{\par     switch (currentView) \{\par       case 'vocabulary':\par         return <VocabularyView ttsConfig=\{ttsConfig\} />;\par       case 'phrases':\par         return <PhrasesView ttsConfig=\{ttsConfig\} />;\par       case 'game':\par         return <GameView ttsConfig=\{ttsConfig\} />;\par       case 'study':\par         return <StudySession ttsConfig=\{ttsConfig\} onComplete=\{() => setCurr\par       case 'stats':\par         return <StatisticsPanel />;\par       case 'listen':\par         return <ListenView ttsConfig=\{ttsConfig\} />;\par       default:\par         return <VocabularyView ttsConfig=\{ttsConfig\} />;\par     \}\par   \};\par \par   const toggleViewMode = () => setIsMobileMode(!isMobileMode);\par \par   return (\par     <div \par       className=\{`min-h-screen flex flex-col bg-slate-50 font-sans transitio\par       style=\{\{ fontSize: `$\{appSettings.fontSizeScale\}rem` \}\}\par     >\par       \{/* Desktop Header */\}\par       \{!isMobileMode && (\par         <header className="bg-white dark:bg-slate-800 shadow-sm sticky top-0\par           <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex i\par             <div className="flex items-center gap-3">\par               \{/* <div className="bg-brand-500 p-2 rounded-lg shadow-sm">\par                  <GraduationCap className="w-6 h-6 text-white" />\par               </div> */\}\par               <h1 className="text-xl font-bold text-slate-800 dark:text-whit\par             </div>\par \par             <nav className="flex items-center gap-1 bg-slate-100 dark:bg-sla\par                <button\par                 onClick=\{() => setCurrentView('study')\}\par                 className=\{`flex items-center gap-2 px-4 py-2 rounded-lg tex\par                   currentView === 'study'\par                     ? 'bg-brand-500 text-white shadow-md'\par                     : 'text-slate-600 dark:text-slate-300 hover:text-slate-9\par                 \}`\}\par               >\par                 <Brain className="w-4 h-4" />\par                 <span>\u26234?\u33021?\u23398?\u20064?</span>\par               </button>\par               <button\par \page                 onClick=\{() => setCurrentView('listen')\}\par                 className=\{`flex items-center gap-2 px-4 py-2 rounded-lg tex\par                   currentView === 'listen'\par                     ? 'bg-white dark:bg-slate-600 text-brand-600 dark:text-w\par                     : 'text-slate-600 dark:text-slate-300 hover:text-slate-9\par                 \}`\}\par               >\par                 <Headphones className="w-4 h-4" />\par                 <span>\u21548?\u35835?</span>\par               </button>\par               <div className="w-px h-6 bg-slate-300 dark:bg-slate-600 mx-1">\par               <button\par                 onClick=\{() => setCurrentView('vocabulary')\}\par                 className=\{`flex items-center gap-2 px-4 py-2 rounded-lg tex\par                   currentView === 'vocabulary'\par                     ? 'bg-white dark:bg-slate-600 text-brand-600 dark:text-w\par                     : 'text-slate-600 dark:text-slate-300 hover:text-slate-9\par                 \}`\}\par               >\par                 <Book className="w-4 h-4" />\par                 <span>\u21333?\u35789?</span>\par               </button>\par               <button\par                 onClick=\{() => setCurrentView('phrases')\}\par                 className=\{`flex items-center gap-2 px-4 py-2 rounded-lg tex\par                   currentView === 'phrases'\par                     ? 'bg-white dark:bg-slate-600 text-brand-600 dark:text-w\par                     : 'text-slate-600 dark:text-slate-300 hover:text-slate-9\par                 \}`\}\par               >\par                 <MessageSquare className="w-4 h-4" />\par                 <span>\u30701?\u35821?</span>\par               </button>\par               <button\par                 onClick=\{() => setCurrentView('game')\}\par                 className=\{`flex items-center gap-2 px-4 py-2 rounded-lg tex\par                   currentView === 'game'\par                     ? 'bg-white dark:bg-slate-600 text-brand-600 dark:text-w\par                     : 'text-slate-600 dark:text-slate-300 hover:text-slate-9\par                 \}`\}\par               >\par                 <Gamepad2 className="w-4 h-4" />\par                 <span>\u22797?\u20064?</span>\par               </button>\par               <button\par                 onClick=\{() => setCurrentView('stats')\}\par                 className=\{`flex items-center gap-2 px-4 py-2 rounded-lg tex\par                   currentView === 'stats'\par                     ? 'bg-white dark:bg-slate-600 text-brand-600 dark:text-w\par                     : 'text-slate-600 dark:text-slate-300 hover:text-slate-9\par \page                 \}`\}\par               >\par                 <BarChart3 className="w-4 h-4" />\par                 <span>\u32479?\u35745?</span>\par               </button>\par             </nav>\par \par             <div className="flex items-center gap-3">\par                 <PomodoroTimer />\par                 <div className="flex gap-1">\par                     <button\par                         onClick=\{toggleViewMode\}\par                         title="\u20999?\u25442?\u21040?\u31227?\u21160?\u31471?\u27169?\u24335?"\par                         className="p-2 text-slate-500 hover:text-brand-600 h\par                     >\par                         <Smartphone className="w-5 h-5" />\par                     </button>\par                     <Button \par                       type="text"\par                       icon=\{<SettingsIcon className="w-5 h-5" />\}\par                       onClick=\{() => setShowSettings(true)\}\par                       className="p-2 text-slate-500 hover:text-brand-600 hov\par                     />\par                 </div>\par             </div>\par           </div>\par         </header>\par       )\}\par \par       \{/* Mobile Header */\}\par       \{isMobileMode && (\par         <header className="bg-white dark:bg-slate-800 shadow-sm sticky top-0\par           <div className="flex items-center gap-2">\par              <GraduationCap className="w-8 h-8 text-brand-500" />\par           </div>\par           <div className="flex gap-1 items-center">\par              <PomodoroTimer />\par              <button\par                 onClick=\{toggleViewMode\}\par                 title="\u20999?\u25442?\u21040?Web\u27169?\u24335?"\par                 className="p-2 text-slate-500 hover:text-brand-600 active:bg\par             >\par                 <Monitor className="w-5 h-5" />\par             </button>\par             <Button\par               type="text"\par               icon=\{<SettingsIcon className="w-5 h-5" />\}\par               onClick=\{() => setShowSettings(true)\}\par               className="p-2 text-slate-500 hover:text-brand-600 active:bg-s\par             />\par \page           </div>\par         </header>\par       )\}\par \par       \{/* Main Content */\}\par       <main className=\{`flex-1 w-full mx-auto px-4 sm:px-6 lg:px-8 py-4 md:p\par         <div className="animate-in fade-in duration-500 slide-in-from-bottom\par           \{renderView()\}\par         </div>\par       </main>\par \par       \{/* Mobile Bottom Navigation */\}\par       \{isMobileMode && (\par         <div className=\{`fixed bottom-0 left-0 right-0 z-50 flex justify-cen\par             <div className="bg-white/90 dark:bg-slate-800/90 backdrop-blur-m\par                 <nav className="flex justify-around items-center h-16">\par                 <button\par                     onClick=\{() => setCurrentView('study')\}\par                     className=\{`flex flex-col items-center justify-center w-\par                     currentView === 'study' ? 'text-brand-600 dark:text-bran\par                     \}`\}\par                 >\par                     <Brain className=\{`w-6 h-6 $\{currentView === 'study' ? '\par                     <span className="text-[10px] font-medium">\u23398?\u20064?</span>\par                 </button>\par                  <button\par                     onClick=\{() => setCurrentView('listen')\}\par                     className=\{`flex flex-col items-center justify-center w-\par                     currentView === 'listen' ? 'text-brand-600 dark:text-bra\par                     \}`\}\par                 >\par                     <Headphones className=\{`w-6 h-6 $\{currentView === 'liste\par                     <span className="text-[10px] font-medium">\u21548?\u35835?</span>\par                 </button>\par                 <button\par                     onClick=\{() => setCurrentView('vocabulary')\}\par                     className=\{`flex flex-col items-center justify-center w-\par                     currentView === 'vocabulary' ? 'text-brand-600 dark:text\par                     \}`\}\par                 >\par                     <Book className=\{`w-6 h-6 $\{currentView === 'vocabulary'\par                     <span className="text-[10px] font-medium">\u35789?\u24211?</span>\par                 </button>\par                 <button\par                     onClick=\{() => setCurrentView('phrases')\}\par                     className=\{`flex flex-col items-center justify-center w-\par                     currentView === 'phrases' ? 'text-brand-600 dark:text-br\par                     \}`\}\par                 >\par                     <MessageSquare className=\{`w-6 h-6 $\{currentView === 'ph\par \page                     <span className="text-[10px] font-medium">\u30701?\u35821?</span>\par                 </button>\par                 <button\par                     onClick=\{() => setCurrentView('game')\}\par                     className=\{`flex flex-col items-center justify-center w-\par                     currentView === 'game' ? 'text-brand-600 dark:text-brand\par                     \}`\}\par                 >\par                     <Gamepad2 className=\{`w-6 h-6 $\{currentView === 'game' ?\par                     <span className="text-[10px] font-medium">\u22797?\u20064?</span>\par                 </button>\par                 </nav>\par             </div>\par         </div>\par       )\}\par \par       \{/* Settings Modal */\}\par       <SettingsPanel\par         isOpen=\{showSettings\}\par         onClose=\{() => setShowSettings(false)\}\par         ttsConfig=\{ttsConfig\}\par         onTTSChange=\{setTtsConfig\}\par         appSettings=\{appSettings\}\par         onAppSettingsChange=\{setAppSettings\}\par         themeMode=\{themeMode\}\par         onThemeModeChange=\{setThemeMode\}\par       />\par     </div>\par   );\par \};\par \par export default App;\par // ===================== \u25991?\u20214?: types.ts =====================\par export enum Category \{\par   DailyLife = "\u26085?\u24120?\u29983?\u27963?",  // Contains: DailyLife, Shopping, Travel, Work, Trans\par   People = "\u20154?\u29289?\u30456?\u20851?",     // Contains: FamilyMembers, BodyParts, Occupations, E\par   Basics = "\u22522?\u30784?\u30693?\u35782?",     // Contains: Colors, Numbers, Time, Grammar\par   Home = "\u23621?\u23478?\u29289?\u21697?",     // Contains: Home\par   DailyCommunication = "\u26085?\u24120?\u27807?\u36890?\u24120?\u29992?\u30701?\u21477?",  // \u26085?\u24120?\u20132?\u27969?\u24120?\u29992?\u30701?\u21477?\par   TravelCommunication = "\u26053?\u34892?\u27807?\u36890?\u24120?\u29992?\u30701?\u21477?", // \u26053?\u34892?\u20132?\u27969?\u24120?\u29992?\u30701?\u21477?\par   WorkCommunication = "\u24037?\u20316?\u27807?\u36890?\u24120?\u29992?\u30701?\u21477?"    // \u24037?\u20316?\u20132?\u27969?\u24120?\u29992?\u30701?\u21477?\par \}\par \par export interface WordItem \{\par   id: string;\par   english: string;\par   chinese: string | string[];\par   pronunciation?: string; // IPA\par   category: Category;\par \}\par \page \par export interface PhraseItem \{\par   id: string;\par   english: string;\par   chinese: string;\par   context: string; // e.g., "At a restaurant"\par   tags: string[];\par \}\par \par export type ViewState = 'vocabulary' | 'phrases' | 'game' | 'study' | 'stats\par \par export interface TTSConfig \{\par   rate: number; // 0.5 to 2\par   pitch: number; // 0 to 2\par   volume: number; // 0 to 1\par   voiceURI_EN?: string; // Preferred English Voice URI\par   voiceURI_ZH?: string; // Preferred Chinese Voice URI\par \}\par \par // === New Types for Study Features ===\par \par export interface AppSettings \{\par   darkMode: boolean;\par   fontSizeScale: number; // 0.8 to 1.2\par   dailyGoal: number; // words per day\par   themeMode?: 'auto' | 'light' | 'dark'; // \u20027?\u39064?\u27169?\u24335?\par \}\par \par export interface ListenSettings \{\par   mode: 'random' | 'category';\par   selectedCategory: Category;\par   batchSize: number;\par   repeatCount: number;\par   intervalMs: number;\par   playbackStrategy?: 'focus' | 'balanced' | 'explore';\par \}\par \par export interface PhrasesSettings \{\par   isRandomMode: boolean;\par   repeatCount: number;\par   intervalMs: number;\par   showChinese: boolean;\par   playRange: 'current' | 'loaded' | 'all' | 'favorites';\par   playMode: 'en-repeat' | 'en-zh-en' | 'zh-en' | 'en-only';\par \}\par \par export interface WordProgress \{\par   wordId: string;\par   nextReview: number; // Timestamp\par   interval: number; // Days\par \page   repetition: number;\par   ef: number; // Easiness Factor\par   status: 'new' | 'learning' | 'review' | 'mastered';\par   lastReviewed: number;\par \}\par \par export interface UserStats \{\par   totalStudyTime: number; // Minutes\par   wordsLearned: number;\par   streakDays: number;\par   lastStudyDate: string; // YYYY-MM-DD\par   todayCount: number;\par \}\par \par export interface Achievement \{\par   id: string;\par   title: string;\par   description: string;\par   icon: string;\par   unlocked: boolean;\par   condition: (stats: UserStats) => boolean;\par \}\par // ===================== \u25991?\u20214?: components/StudySession.tsx ===================\par import React, \{ useState, useEffect, useCallback, useRef \} from "react";\par import \{\par   Play,\par   RotateCcw,\par   Award,\par   CheckCircle2,\par   XCircle,\par   Volume2,\par   ArrowRight,\par   SlidersHorizontal,\par   Sparkles,\par   Speaker,\par   X,\par   Snail,\par \} from "lucide-react";\par import \{ Category, PhraseItem, WordItem, WordProgress, TTSConfig \} from "../\par import \{ vocabularyData \} from "../data/vocabulary";\par import \{ phrasesData \} from "../data/phrases";\par import \{ storageService \} from "../services/storage";\par import \{ calculateReview \} from "../services/srs";\par import \{ ttsService \} from "../services/ttsService";\par \par interface StudySessionProps \{\par   ttsConfig: TTSConfig;\par   onComplete: () => void;\par \}\par \par \page interface QuizOption \{\par   id: string;\par   text: string;\par   isCorrect: boolean;\par \}\par \par interface PhraseToken \{\par   id: string;\par   text: string;\par   normalized: string;\par \}\par \par // \u21548?\u21147?\u25340?\u21477?\u32451?\u20064?\u29366?\u24577?\par type ListenPhase = 'idle' | 'answering' | 'checking' | 'feedback';\par \par interface ListenExerciseState \{\par   phase: ListenPhase;\par   playsRemaining: number;\par   selectedTokens: PhraseToken[];\par   availableTokens: PhraseToken[];\par   targetTokens: PhraseToken[];\par   feedback: 'correct' | 'wrong' | null;\par   showAnswer: boolean;\par \}\par \par // \u38590?\u24230?\u32423?\u21035?\u23450?\u20041?\par type DifficultyLevel = 'short' | 'medium' | 'long';\par \par interface DifficultyConfig \{\par   label: string;\par   minWords: number;\par   maxWords: number;\par   color: string;\par \}\par \par const DIFFICULTY_CONFIG: Record<DifficultyLevel, DifficultyConfig> = \{\par   short: \{ label: '\u30701?\u21477?', minWords: 1, maxWords: 5, color: 'bg-emerald-500' \},\par   medium: \{ label: '\u20013?\u21477?', minWords: 5, maxWords: 7, color: 'bg-amber-500' \},\par   long: \{ label: '\u38271?\u21477?', minWords: 8, maxWords: Infinity, color: 'bg-rose-500'\par \};\par \par const getDifficultyByLength = (wordCount: number): DifficultyLevel => \{\par   if (wordCount <= 5) return 'short';\par   if (wordCount <= 7) return 'medium';\par   return 'long';\par \};\par \par export const StudySession: React.FC<StudySessionProps> = (\{\par   ttsConfig,\par   onComplete,\par \page \}) => \{\par   const [studyMode, setStudyMode] = useState<"quiz" | "listen">("quiz");\par   const [batch, setBatch] = useState<WordItem[]>([]);\par   const [currentIndex, setCurrentIndex] = useState(0);\par   const [sessionComplete, setSessionComplete] = useState(false);\par   const [progressMap, setProgressMap] = useState<Record<string, WordProgress\par     \{\}\par   );\par   const [batchSize, setBatchSize] = useState(10);\par \par   // \u21548?\u21147?\u25340?\u21477?\u29366?\u24577?\u65288?\u22810?\u37051?\u22269?\u39118?\u26684?\u65289?\par   const [phraseBatch, setPhraseBatch] = useState<PhraseItem[]>([]);\par   const [phraseIndex, setPhraseIndex] = useState(0);\par   const [listenComplete, setListenComplete] = useState(false);\par   const sessionStartTime = useRef<number>(Date.now());\par   const [listenState, setListenState] = useState<ListenExerciseState>(\{\par     phase: 'idle',\par     playsRemaining: 3,\par     selectedTokens: [],\par     availableTokens: [],\par     targetTokens: [],\par     feedback: null,\par     showAnswer: false,\par   \});\par   const MAX_PLAYS = 3; // \u26368?\u22810?\u25773?\u25918?\u27425?\u25968?\par \par   // \u38590?\u24230?\u36873?\u25321? - \u25903?\u25345?\u22810?\u36873?\par   const [selectedDifficulties, setSelectedDifficulties] = useState<Set<Diffi\par \par   // Quiz State\par   const [options, setOptions] = useState<QuizOption[]>([]);\par   const [selectedOptionId, setSelectedOptionId] = useState<string | null>(nu\par   const [wrongAttempts, setWrongAttempts] = useState<Set<string>>(new Set())\par   const [isProcessing, setIsProcessing] = useState(false); // Prevent double\par   const [eliminatedOptionIds, setEliminatedOptionIds] = useState<Set<string>\par     new Set()\par   );\par   const [hintUsed, setHintUsed] = useState(false);\par   const quizTtsTimerRef = useRef<number | null>(null);\par   const nextWordTimerRef = useRef<number | null>(null);\par   const nextPhraseTimerRef = useRef<number | null>(null);\par   const phraseTtsTimerRef = useRef<number | null>(null);\par \par   // Function to generate a new batch of words\par   const generateBatch = useCallback(() => \{\par     const savedProgress = storageService.getProgress();\par     setProgressMap(savedProgress);\par \par     const now = Date.now();\par \par \page     // 1. Find words due for review\par     const dueWords = vocabularyData.filter((w) => \{\par       const p = savedProgress[w.id];\par       // If p exists and nextReview is in the past\par       return p && p.nextReview <= now;\par     \});\par \par     // 2. Find new words (never studied)\par     const newWords = vocabularyData.filter((w) => !savedProgress[w.id]);\par \par     // 3. Create a batch of batchSize\par     let sessionWords = [...dueWords];\par \par     if (sessionWords.length < batchSize) \{\par       const shuffledNew = [...newWords].sort(() => 0.5 - Math.random());\par       sessionWords = [\par         ...sessionWords,\par         ...shuffledNew.slice(0, batchSize - sessionWords.length),\par       ];\par     \} else \{\par       sessionWords = sessionWords.slice(0, batchSize);\par     \}\par \par     // Fallback if empty (if user mastered everything or no due words)\par     // Just pick random words to keep practicing\par     if (sessionWords.length === 0) \{\par       sessionWords = [...vocabularyData]\par         .sort(() => 0.5 - Math.random())\par         .slice(0, batchSize);\par     \}\par \par     setBatch(sessionWords);\par     setCurrentIndex(0);\par     setSessionComplete(false);\par     setWrongAttempts(new Set());\par     setSelectedOptionId(null);\par     setIsProcessing(false);\par   \}, [batchSize]);\par \par   const generatePhraseBatch = useCallback(() => \{\par     let filtered = phrasesData;\par \par     // \u26681?\u25454?\u38590?\u24230?\u36807?\u28388?\u21477?\u23376? - \u25903?\u25345?\u22810?\u36873?\par     if (selectedDifficulties.size > 0) \{\par       filtered = phrasesData.filter(phrase => \{\par         const wordCount = phrase.english.split(/\\s+/).length;\par         const difficulty = getDifficultyByLength(wordCount);\par         return selectedDifficulties.has(difficulty);\par       \});\par     \}\par \page \par     // \u22914?\u26524?\u36807?\u28388?\u21518?\u20026?\u31354?\u65292?\u20351?\u29992?\u20840?\u37096?\u25968?\u25454?\par     if (filtered.length === 0) \{\par       filtered = phrasesData;\par     \}\par \par     const shuffled = [...filtered].sort(() => 0.5 - Math.random());\par     setPhraseBatch(shuffled.slice(0, batchSize));\par     setPhraseIndex(0);\par     setListenComplete(false);\par     resetListenState();\par   \}, [batchSize, selectedDifficulties]);\par \par   const resetListenState = () => \{\par     setListenState(\{\par       phase: 'answering',\par       playsRemaining: MAX_PLAYS,\par       selectedTokens: [],\par       availableTokens: [],\par       targetTo