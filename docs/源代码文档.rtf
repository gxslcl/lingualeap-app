te-700 bord\par                     >\par                         <option value="">\u33258?\u21160?\u25512?\u33616? (System Default)</option>\par                         \{availableVoices.en.map(v => (\par                             <option key=\{v.voiceURI\} value=\{v.voiceURI\}>\par                                 \{v.name.replace(/English|United States/g, ''\par                             </option>\par                         ))\}\par                     </select>\par                 </div>\par              </div>\par \par              \{/* Voice Selection - Chinese */\}\par              <div>\par                 <label className="text-sm font-medium flex items-center gap-\par                     <Mic className="w-4 h-4" />\par                     \u20013?\u25991?\u21457?\u38899?\u20154?\par                 </label>\par                 <div className="flex gap-2">\par                     <select \par                         value=\{ttsConfig.voiceURI_ZH || ''\}\par                         onChange=\{(e) => \{\par                              const newUri = e.target.value;\par                              onTTSChange(\{ ...ttsConfig, voiceURI_ZH: newUri\par                              handleTestVoice('zh', newUri);\par                         \}\}\par                         className="flex-1 bg-slate-50 dark:bg-slate-700 bord\par                     >\par                         <option value="">\u33258?\u21160?\u25512?\u33616? (System Default)</option>\par                         \{availableVoices.zh.map(v => (\par                             <option key=\{v.voiceURI\} value=\{v.voiceURI\}>\par                                 \{v.name.replace(/Chinese|China|Hong Kong|Tai\par                             </option>\par                         ))\}\par \page                     </select>\par                 </div>\par              </div>\par \par              \{/* Rate Control */\}\par             <div>\par                 <div className="flex justify-between mb-2 items-center">\par                 <label className="text-sm font-medium flex items-center gap-\par                     <Gauge className="w-4 h-4" />\par                     \u35821?\u36895?\par                 </label>\par                 <span className="text-xs font-mono bg-slate-100 dark:bg-slat\par                 </div>\par                 <input\par                 type="range"\par                 min="0.5"\par                 max="1.5"\par                 step="0.1"\par                 value=\{ttsConfig.rate\}\par                 onChange=\{(e) => onTTSChange(\{ ...ttsConfig, rate: parseFloa\par                 className="w-full h-2 bg-slate-200 dark:bg-slate-700 rounded\par                 />\par             </div>\par \par             \{/* Volume Control */\}\par             <div>\par                 <div className="flex justify-between mb-2 items-center">\par                 <label className="text-sm font-medium flex items-center gap-\par                     <Volume2 className="w-4 h-4" />\par                     \u38899?\u37327?\par                 </label>\par                 <span className="text-xs font-mono bg-slate-100 dark:bg-slat\par                 </div>\par                 <input\par                 type="range"\par                 min="0"\par                 max="1"\par                 step="0.1"\par                 value=\{ttsConfig.volume\}\par                 onChange=\{(e) => onTTSChange(\{ ...ttsConfig, volume: parseFl\par                 className="w-full h-2 bg-slate-200 dark:bg-slate-700 rounded\par                 />\par             </div>\par           </div>\par         </div>\par \par         <div className="mt-8 flex justify-end flex-shrink-0">\par           <button\par             onClick=\{onClose\}\par             className="w-full sm:w-auto px-8 py-3 bg-brand-500 hover:bg-bran\par \page           >\par             \u23436?\u25104?\par           </button>\par         </div>\par       </div>\par     </div>\par   );\par \};\par // ===================== \u25991?\u20214?: components/PomodoroTimer.tsx ==================\par import React, \{ useState, useEffect \} from 'react';\par import \{ Timer, Pause, Play, RotateCcw \} from 'lucide-react';\par import \{ storageService \} from '../services/storage';\par \par export const PomodoroTimer: React.FC = () => \{\par   const [timeLeft, setTimeLeft] = useState(25 * 60);\par   const [isActive, setIsActive] = useState(false);\par   const [sessionCount, setSessionCount] = useState(0);\par \par   useEffect(() => \{\par     let interval: ReturnType<typeof setInterval>;\par \par     if (isActive && timeLeft > 0) \{\par       interval = setInterval(() => \{\par         setTimeLeft((time) => \{\par            if (time % 60 === 0) \{\par                // Update stats every minute\par                storageService.updateStudyTime(1/60); // Add 1 second worth o\par            \}\par            return time - 1;\par         \});\par       \}, 1000);\par     \} else if (timeLeft === 0) \{\par       setIsActive(false);\par       setSessionCount(prev => prev + 1);\par       // Play sound or notify\par       alert("\u19987?\u27880?\u26102?\u38388?\u32467?\u26463?\u65281?\u20241?\u24687?\u19968?\u19979?\u21543?\u12290?");\par       setTimeLeft(25 * 60);\par     \}\par \par     return () => clearInterval(interval);\par   \}, [isActive, timeLeft]);\par \par   // Log time in larger chunks to storage for performance\par   useEffect(() => \{\par       if (isActive) \{\par           const saveInterval = setInterval(() => \{\par              storageService.updateStudyTime(1); // 1 minute\par           \}, 60000);\par           return () => clearInterval(saveInterval);\par       \}\par \page   \}, [isActive]);\par \par   const toggleTimer = () => setIsActive(!isActive);\par   const resetTimer = () => \{\par     setIsActive(false);\par     setTimeLeft(25 * 60);\par   \};\par \par   const formatTime = (seconds: number) => \{\par     const mins = Math.floor(seconds / 60);\par     const secs = seconds % 60;\par     return `$\{mins\}:$\{secs < 10 ? '0' : ''\}$\{secs\}`;\par   \};\par \par   return (\par     <div className="bg-white dark:bg-slate-800 rounded-xl shadow-sm border b\par       <div className=\{`p-2 rounded-full $\{isActive ? 'bg-red-100 text-red-50\par         <Timer className="w-5 h-5" />\par       </div>\par       <div>\par         <div className="text-xl font-mono font-bold text-slate-800 dark:text\par           \{formatTime(timeLeft)\}\par         </div>\par         <div className="text-[10px] text-slate-400 dark:text-slate-500 font-\par            \{isActive ? '\u19987?\u27880?\u20013?...' : '\u30058?\u33540?\u38047?'\}\par         </div>\par       </div>\par       <div className="flex gap-1 ml-2">\par         <button \par             onClick=\{toggleTimer\}\par             className="p-1.5 hover:bg-slate-100 dark:hover:bg-slate-700 roun\par         >\par           \{isActive ? <Pause className="w-4 h-4" /> : <Play className="w-4 h\par         </button>\par         <button \par             onClick=\{resetTimer\}\par             className="p-1.5 hover:bg-slate-100 dark:hover:bg-slate-700 roun\par         >\par           <RotateCcw className="w-4 h-4" />\par         </button>\par       </div>\par     </div>\par   );\par \};\par // ===================== \u25991?\u20214?: services/srs.ts =====================\par import \{ WordProgress \} from '../types';\par \par // Simplified SuperMemo-2 Algorithm\par export const calculateReview = (\par   currentProgress: WordProgress | undefined,\par \page   quality: number // 0-5 rating\par ): WordProgress => \{\par   const now = Date.now();\par   \par   if (!currentProgress) \{\par     // Initial learning\par     return \{\par       wordId: '', // Set by caller\par       nextReview: now + (quality < 3 ? 0 : 24 * 60 * 60 * 1000), // Next day\par       interval: quality < 3 ? 0 : 1,\par       repetition: quality < 3 ? 0 : 1,\par       ef: 2.5,\par       status: quality < 3 ? 'learning' : 'review',\par       lastReviewed: now\par     \};\par   \}\par   let \{ interval, repetition, ef \} = currentProgress;\par   if (quality >= 3) \{\par     if (repetition === 0) \{\par       interval = 1;\par     \} else if (repetition === 1) \{\par       interval = 6;\par     \} else \{\par       interval = Math.round(interval * ef);\par     \}\par     repetition += 1;\par   \} else \{\par     repetition = 0;\par     interval = 1;\par   \}\par \par   // Update Easiness Factor\par   ef = ef + (0.1 - (5 - quality) * (0.08 + (5 - quality) * 0.02));\par   if (ef < 1.3) ef = 1.3;\par \par   const nextReview = now + (interval * 24 * 60 * 60 * 1000);\par \par   return \{\par     ...currentProgress,\par     nextReview,\par     interval,\par     repetition,\par     ef,\par     status: interval > 21 ? 'mastered' : 'review',\par     lastReviewed: now\par   \};\par \};\par // ===================== \u25991?\u20214?: services/ttsService.ts =====================\par import \{ TTSConfig \} from '../types';\par \par \page class TTSService \{\par   private synth: SpeechSynthesis;\par   private voices: SpeechSynthesisVoice[] = [];\par   private onVoicesChangedCallbacks: ((voices: SpeechSynthesisVoice[]) => voi\par \par   constructor() \{\par     this.synth = window.speechSynthesis;\par     // Initial load\par     this.loadVoices();\par \par     // Async load (some browsers need this)\par     if (this.synth.onvoiceschanged !== undefined) \{\par       this.synth.onvoiceschanged = () => \{\par         this.loadVoices();\par         this.notifyListeners();\par       \};\par     \}\par   \}\par \par   private loadVoices() \{\par     const allVoices = this.synth.getVoices();\par     // Sort voices to prioritize high-quality ones\par     this.voices = allVoices.sort((a, b) => \{\par       const getScore = (v: SpeechSynthesisVoice) => \{\par         let score = 0;\par         // Keywords often associated with higher quality voices\par         if (v.name.includes('Google') ||\par           v.name.includes('Natural') ||\par           v.name.includes('Premium') ||\par           v.name.includes('Enhanced') ||\par           v.name.includes('Siri')) score += 5;\par         if (v.default) score += 2;\par         if (v.localService) score += 1;\par         return score;\par       \};\par       return getScore(b) - getScore(a);\par     \});\par   \}\par \par   private notifyListeners() \{\par     this.onVoicesChangedCallbacks.forEach(cb => cb(this.voices));\par   \}\par \par   public subscribeToVoicesChanged(callback: (voices: SpeechSynthesisVoice[])\par     this.onVoicesChangedCallbacks.push(callback);\par     // Immediately invoke with current voices if available\par     if (this.voices.length > 0) \{\par       callback(this.voices);\par     \}\par     return () => \{\par \page       this.onVoicesChangedCallbacks = this.onVoicesChangedCallbacks.filter(c\par     \};\par   \}\par \par   public getVoices() \{\par     if (this.voices.length === 0) this.loadVoices();\par     return this.voices;\par   \}\par \par   public getGroupedVoices() \{\par     if (this.voices.length === 0) this.loadVoices();\par     return \{\par       en: this.voices.filter(v => v.lang.startsWith('en')),\par       zh: this.voices.filter(v => v.lang.startsWith('zh'))\par     \};\par   \}\par \par   public speak(text: string, config: TTSConfig, lang: string = 'en-US', onEn\par     // Cancel any ongoing speech to prevent overlap or queueing if user is s\par     if (this.synth.speaking || this.synth.pending) \{\par       this.synth.cancel();\par     \}\par \par     // Double check voices if empty (sometimes happens on first load)\par     if (this.voices.length === 0) \{\par       this.loadVoices();\par     \}\par \par     const utterance = new SpeechSynthesisUtterance(text);\par \par     // Find voice based on requested language and config\par     let preferredVoice: SpeechSynthesisVoice | undefined;\par \par     const findVoice = (uri: string | undefined, langPrefix: string) => \{\par       if (uri) \{\par         return this.voices.find(v => v.voiceURI === uri);\par       \}\par       // Smart fallback logic is now partly handled by the sorting in loadVo\par       // but we double check here to ensure we pick the right language famil\par       return this.voices.find(v => v.lang.startsWith(langPrefix));\par     \};\par \par     if (lang.startsWith('zh')) \{\par       preferredVoice = findVoice(config.voiceURI_ZH, 'zh');\par       // Fallback for Chinese if no voice matches 'zh' prefix exactly (rare)\par       if (!preferredVoice) preferredVoice = this.voices.find(v => v.lang.inc\par     \} else \{\par       preferredVoice = findVoice(config.voiceURI_EN, 'en');\par       // Fallback for English\par       if (!preferredVoice) preferredVoice = this.voices.find(v => v.lang.sta\par \page     \}\par \par     if (preferredVoice) \{\par       utterance.voice = preferredVoice;\par     \} else \{\par       // If no voice object found, rely on lang tag\par       utterance.lang = lang;\par     \}\par \par     utterance.rate = config.rate;\par     utterance.pitch = config.pitch;\par     utterance.volume = config.volume;\par \par     utterance.onend = () => \{\par       if (onEnd) onEnd();\par     \};\par \par     // Robust error handling\par     utterance.onerror = (e) => \{\par       // 'interrupted' or 'canceled' are expected when user skips or pauses\par       if (e.error === 'interrupted' || e.error === 'canceled') \{\par         return;\par       \}\par \par       // Log gracefully, e.error is a string in the spec, but let's be safe\par       console.warn("TTS Playback Warning:", e.error);\par \par       // Ensure the app flow continues even if audio fails\par       if (onEnd) onEnd();\par     \};\par \par     try \{\par       this.synth.speak(utterance);\par     \} catch (err) \{\par       console.error("TTS System Error:", err);\par       // Ensure callbacks fire so UI doesn't get stuck\par       if (onEnd) onEnd();\par     \}\par   \}\par \par   // \u24930?\u36895?\u25773?\u25918?\u21151?\u33021? - \u36880?\u20010?\u21333?\u35789?\u25773?\u25918?\par   public slowSpeak(text: string, config: TTSConfig, wordInterval: number = 0\par     // \u21462?\u28040?\u27491?\u22312?\u36827?\u34892?\u30340?\u35821?\u38899?\par     if (this.synth.speaking || this.synth.pending) \{\par       this.synth.cancel();\par     \}\par \par     // \u20998?\u21106?\u25991?\u26412?\u20026?\u21333?\u35789?\u25968?\u32452?\u65288?\u31616?\u21333?\u25353?\u31354?\u26684?\u20998?\u21106?\u65289?\par     const words = text.trim().split(/\\s+/).filter(word => word.length > 0);\par \par \page     if (words.length === 0) \{\par       if (onComplete) onComplete();\par       return;\par     \}\par \par     let currentIndex = 0;\par \par     const playNextWord = () => \{\par       if (currentIndex >= words.length) \{\par         if (onComplete) onComplete();\par         return;\par       \}\par \par       const word = words[currentIndex];\par       if (onWordPlay) onWordPlay(word, currentIndex);\par \par       const utterance = new SpeechSynthesisUtterance(word);\par \par       // \u35774?\u32622?\u35821?\u38899?\u37197?\u32622?\par       let preferredVoice = this.voices.find(v => v.voiceURI === config.voice\par         this.voices.find(v => v.lang.startsWith('en'));\par \par       if (preferredVoice) \{\par         utterance.voice = preferredVoice;\par       \}\par \par       utterance.rate = config.rate; // \u20351?\u29992?\u27491?\u24120?\u36895?\u24230?\u32780?\u19981?\u26159?\u24930?\u36895?\par       utterance.pitch = config.pitch;\par       utterance.volume = config.volume;\par \par       utterance.onend = () => \{\par         currentIndex++;\par         setTimeout(playNextWord, wordInterval);\par       \};\par \par       utterance.onerror = () => \{\par         currentIndex++;\par         setTimeout(playNextWord, wordInterval);\par       \};\par \par       this.synth.speak(utterance);\par     \};\par \par     playNextWord();\par   \}\par \par   public cancel() \{\par     this.synth.cancel();\par   \}\par \}\par \page \par export const ttsService = new TTSService();\par // ===================== \u25991?\u20214?: services/storage.ts =====================\par \par import \{ WordProgress, UserStats, AppSettings, TTSConfig, ListenSettings, Ca\par \par const KEYS = \{\par   PROGRESS: 'lingualeap_progress',\par   STATS: 'lingualeap_stats',\par   SETTINGS: 'lingualeap_settings',\par   TTS_CONFIG: 'lingualeap_tts_config',\par   LISTEN_SETTINGS: 'lingualeap_listen_settings',\par   PHRASES_SETTINGS: 'lingualeap_phrases_settings',\par \};\par \par const DEFAULT_STATS: UserStats = \{\par   totalStudyTime: 0,\par   wordsLearned: 0,\par   streakDays: 0,\par   lastStudyDate: '',\par   todayCount: 0,\par \};\par const DEFAULT_SETTINGS: AppSettings = \{\par   darkMode: false,\par   fontSizeScale: 1.0,\par   dailyGoal: 20,\par \};\par \par const DEFAULT_TTS_CONFIG: TTSConfig = \{\par   rate: 1.0,\par   pitch: 1.0,\par   volume: 1.0,\par   voiceURI_EN: undefined,\par   voiceURI_ZH: undefined\par \};\par \par const DEFAULT_LISTEN_SETTINGS: ListenSettings = \{\par   mode: 'random',\par   selectedCategory: Object.values(Category)[0],\par   batchSize: 10,\par   repeatCount: 2,\par   intervalMs: 500,\par   playbackStrategy: 'balanced',\par \};\par \par const DEFAULT_PHRASES_SETTINGS: PhrasesSettings = \{\par   isRandomMode: true,\par   repeatCount: 2,\par   intervalMs: 500,\par   showChinese: true,\par \page   playRange: 'loaded',\par   playMode: 'en-zh-en'\par \};\par \par export const storageService = \{\par   // Progress\par   saveProgress: (progress: Record<string, WordProgress>) => \{\par     localStorage.setItem(KEYS.PROGRESS, JSON.stringify(progress));\par   \},\par \par   getProgress: (): Record<string, WordProgress> => \{\par     const data = localStorage.getItem(KEYS.PROGRESS);\par     return data ? JSON.parse(data) : \{\};\par   \},\par \par   // Stats\par   saveStats: (stats: UserStats) => \{\par     localStorage.setItem(KEYS.STATS, JSON.stringify(stats));\par   \},\par \par   getStats: (): UserStats => \{\par     const data = localStorage.getItem(KEYS.STATS);\par     if (!data) return DEFAULT_STATS;\par     \par     const stats = JSON.parse(data);\par     \par     // Check for streak updates\par     const today = new Date().toISOString().split('T')[0];\par     if (stats.lastStudyDate !== today) \{\par       // Logic for streak could be improved, but simple check:\par       const last = new Date(stats.lastStudyDate);\par       const curr = new Date(today);\par       const diffTime = Math.abs(curr.getTime() - last.getTime());\par       const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)); \par \par       if (diffDays > 1 && stats.lastStudyDate !== '') \{\par         stats.streakDays = 0; // Reset streak if missed a day\par       \}\par       stats.todayCount = 0; // Reset daily count\par     \}\par     \par     return stats;\par   \},\par \par   updateStudyTime: (minutes: number) => \{\par     const stats = storageService.getStats();\par     stats.totalStudyTime += minutes;\par     const today = new Date().toISOString().split('T')[0];\par     \par     if (stats.lastStudyDate !== today) \{\par \page         if (stats.lastStudyDate) \{\par              const last = new Date(stats.lastStudyDate);\par              const curr = new Date(today);\par              const diffDays = Math.ceil(Math.abs(curr.getTime() - last.getTi\par              if (diffDays === 1) stats.streakDays += 1;\par              else if (diffDays > 1) stats.streakDays = 1;\par         \} else \{\par             stats.streakDays = 1;\par         \}\par         stats.lastStudyDate = today;\par     \}\par     \par     storageService.saveStats(stats);\par     return stats;\par   \},\par \par   updateWordStats: (isMastered: boolean) => \{\par     const stats = storageService.getStats();\par     const today = new Date().toISOString().split('T')[0];\par     \par     // Ensure date is updated to prevent reset on next read\par     if (stats.lastStudyDate !== today) \{\par         if (stats.lastStudyDate) \{\par              const last = new Date(stats.lastStudyDate);\par              const curr = new Date(today);\par              const diffDays = Math.ceil(Math.abs(curr.getTime() - last.getTi\par              if (diffDays === 1) stats.streakDays += 1;\par              else if (diffDays > 1) stats.streakDays = 1;\par         \} else \{\par             stats.streakDays = 1;\par         \}\par         stats.lastStudyDate = today;\par     \}\par \par     stats.todayCount += 1;\par     if (isMastered) \{\par       stats.wordsLearned += 1;\par     \}\par     \par     storageService.saveStats(stats);\par     return stats;\par   \},\par \par   // App Settings\par   saveSettings: (settings: AppSettings) => \{\par     localStorage.setItem(KEYS.SETTINGS, JSON.stringify(settings));\par     // Apply dark mode immediately\par     if (settings.darkMode) \{\par       document.documentElement.classList.add('dark');\par     \} else \{\par \page       document.documentElement.classList.remove('dark');\par     \}\par   \},\par \par   getSettings: (): AppSettings => \{\par     const data = localStorage.getItem(KEYS.SETTINGS);\par     const settings = data ? JSON.parse(data) : DEFAULT_SETTINGS;\par     // Initial apply\par     if (settings.darkMode) \{\par       document.documentElement.classList.add('dark');\par     \}\par     return settings;\par   \},\par \par   // TTS Config\par   saveTTSConfig: (config: TTSConfig) => \{\par     localStorage.setItem(KEYS.TTS_CONFIG, JSON.stringify(config));\par   \},\par \par   getTTSConfig: (): TTSConfig => \{\par     const data = localStorage.getItem(KEYS.TTS_CONFIG);\par     return data ? JSON.parse(data) : DEFAULT_TTS_CONFIG;\par   \},\par \par   // Listen View Settings\par   saveListenSettings: (settings: ListenSettings) => \{\par     localStorage.setItem(KEYS.LISTEN_SETTINGS, JSON.stringify(settings));\par   \},\par \par   getListenSettings: (): ListenSetting